# Existing project settings
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=kubernetes_docs

RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_EMBEDDING_DEVICE=auto
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_MAX_LENGTH=512

# Multi-source files
RAG_GITHUB_ISSUES_FILE=data/processed/github_issues.jsonl
RAG_DOCUMENTS_ALL_FILE=data/processed/documents_all.jsonl

# Existing data paths can still be overridden
# RAG_DOCUMENTS_FILE=
# RAG_PARENTS_FILE=
# RAG_CHUNKS_FILE=
# RAG_PARENT_DB_FILE=

# Retrieval
RAG_DENSE_TOP_K=30
RAG_BM25_TOP_K=30
RAG_RRF_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_FINAL_TOP_PARENTS=5

# Scope
RAG_DEFAULT_CATEGORY=concepts
RAG_DEFAULT_DOC_TYPE=documentation
RAG_DEFAULT_SOURCE_TYPE=documentation
