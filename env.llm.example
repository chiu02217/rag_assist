# Qwen3.5 2B served locally by Ollama
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=qwen3.5:2b
RAG_LLM_API_KEY=ollama
RAG_LLM_TIMEOUT_SECONDS=120
RAG_LLM_MAX_TOKENS=800
RAG_LLM_TEMPERATURE=0.1
RAG_MAX_CONTEXT_CHARS=12000

# On a 6GB GPU, keep the CrossEncoder reranker on CPU if Ollama and the
# reranker compete for VRAM. This slows reranking, but leaves more GPU memory
# available for Qwen3.5 2B.
RAG_RERANKER_DEVICE=cpu
