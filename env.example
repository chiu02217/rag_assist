# Optional project root override
# RAG_PROJECT_ROOT=C:\Users\p1382\Desktop\rag_assist

# Qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=kubernetes_docs

# Models
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_EMBEDDING_DEVICE=auto
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=4

# Data locations (leave blank to use defaults)
# RAG_KUBERNETES_DOCS_DIR=
# RAG_DOCUMENTS_FILE=
# RAG_PARENTS_FILE=
# RAG_CHUNKS_FILE=
# RAG_PARENT_DB_FILE=
# RAG_EVAL_DATASET=
# RAG_EVAL_RESULTS_JSON=
# RAG_EVAL_RESULTS_CSV=

# Chunking / indexing
RAG_PARENT_MAX_CHARS=4000
RAG_PARENT_OVERLAP_CHARS=400
RAG_CHILD_CHUNK_SIZE=1200
RAG_CHILD_OVERLAP=200
RAG_EMBED_BATCH_SIZE=8
# RAG_MAX_CHUNKS=
RAG_VECTOR_SIZE=1024

# Retrieval
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_FINAL_TOP_PARENTS=5

# Metadata defaults
RAG_DEFAULT_CATEGORY=concepts
RAG_DEFAULT_DOC_TYPE=documentation
RAG_DOCUMENTATION_SOURCE=Kubernetes Documentation
